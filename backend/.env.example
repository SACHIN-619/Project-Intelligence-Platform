# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Project Impact Intelligence"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# ─── Database ─────────────────────────────────────────────────────────────────
# For Neon Tech: postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
# For Supabase Pooler: postgresql+asyncpg://postgres.ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/pii
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis (optional — falls back cleanly to in-process queue) ────────────────
REDIS_URL=redis://localhost:6379/0

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local development or S3 / Cloudflare R2
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_PATH=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=               # Optional: for R2 or MinIO: https://<account>.r2.cloudflarestorage.com

# ─── AI Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# Optional Groq fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_CACHE_TTL_SECONDS=3600

# ─── Monte Carlo ──────────────────────────────────────────────────────────────
MC_N_SIMULATIONS=1000
MC_OPTIMISTIC_FACTOR=0.8
MC_PESSIMISTIC_FACTOR=1.5

# ─── Risk Engine ──────────────────────────────────────────────────────────────
RISK_THRESHOLD_LOW=3.0
RISK_THRESHOLD_MEDIUM=6.0
RISK_THRESHOLD_HIGH=9.0
RECOVERY_MIN_BENEFIT_DAYS=1

# ─── Auth ─────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_RAG_ENABLED=true
FEATURE_MONTE_CARLO_ENABLED=true
FEATURE_PDF_EXPORT_ENABLED=true
FEATURE_WEATHER_AGENT_ENABLED=false
FEATURE_VENDOR_SCORING_ENABLED=true
FEATURE_AI_MEMORY_ENABLED=true
